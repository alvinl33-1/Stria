STRIA_DB_PASSWORD=replace-with-a-strong-local-password

# Microsoft Entra test tenant (see docs/ENTRA_SETUP.md). IDs are not secret; the client secret is.
STRIA_TENANT_ID=00000000-0000-0000-0000-000000000000
STRIA_CLIENT_ID=00000000-0000-0000-0000-000000000000
STRIA_CLIENT_SECRET=replace-with-the-app-registration-client-secret

# Data-plane key for the sample PaymentGateway service (see README). Stria stores only the hash.
STRIA_PAYMENTGATEWAY_KEY=replace-with-openssl-rand-output
STRIA_PAYMENTGATEWAY_KEY_SHA256=replace-with-sha256-hex-of-the-key