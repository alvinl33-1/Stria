@inject NavigationManager Navigation

@code {
    // A full page load (forceLoad) is required: sign-in is a server endpoint that redirects to
    // Microsoft Entra, not a client-side route.
    protected override void OnInitialized()
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"authentication/login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
