@page "/"
@attribute [Authorize(Policy = ChaosPolicies.View)]
@inject ChaosApiClient Api
@inject ILogger<Home> Logger

<PageTitle>Stria | Resilience Console</PageTitle>

<main class="stria-console">
    <header class="console-header">
        <a class="wordmark" href="/" aria-label="Stria home"><span class="wordmark-mark">S</span> STRIA</a>
        <span class="header-caption">RESILIENCE / CONTROL</span>
        <span class="environment-tag"><span class="environment-dot"></span> LOCAL ENVIRONMENT</span>
    </header>

    <section class="page-intro">
        <div class="eyebrow">FAULT INJECTION</div>
        <h1>Service control</h1>
        <p>Introduce a controlled fault to test how dependent systems respond. Changes take effect immediately.</p>
    </section>

    <KillSwitchPanel EngagedChanged="OnKillSwitchChanged" />

    <section class="service-grid" aria-label="Service fault controls">
        <article class="service-panel">
            <div class="service-index">01 <span>PAYMENTS</span></div>
            <h2>Payment Gateway</h2>
            <p>Add a three second delay to payment requests.</p>
            <AuthorizeView Policy="@ChaosPolicies.Operate">
                <Authorized>
                    <div class="service-actions">
                        <button class="action-button action-warn" disabled="@(_isSubmitting || _killSwitchEngaged)" @onclick='() => CommitChaos("PaymentGateway", "Latency")'>Inject latency <span>↗</span></button>
                        <button class="clear-button" disabled="@_isSubmitting" @onclick='() => CommitChaos("PaymentGateway", "None")'>Clear fault</button>
                    </div>
                </Authorized>
                <NotAuthorized><p class="view-only">View only</p></NotAuthorized>
            </AuthorizeView>
        </article>
        <article class="service-panel">
            <div class="service-index">02 <span>IDENTITY</span></div>
            <h2>Auth Service</h2>
            <p>Return simulated HTTP 503 responses.</p>
            <AuthorizeView Policy="@ChaosPolicies.Operate">
                <Authorized>
                    <div class="service-actions">
                        <button class="action-button action-danger" disabled="@(_isSubmitting || _killSwitchEngaged)" @onclick='() => CommitChaos("AuthService", "HttpFailure")'>Inject HTTP 503 <span>↗</span></button>
                        <button class="clear-button" disabled="@_isSubmitting" @onclick='() => CommitChaos("AuthService", "None")'>Clear fault</button>
                    </div>
                </Authorized>
                <NotAuthorized><p class="view-only">View only</p></NotAuthorized>
            </AuthorizeView>
        </article>
        <article class="service-panel">
            <div class="service-index">03 <span>INVENTORY</span></div>
            <h2>Inventory API</h2>
            <p>CPU spike injection is not available yet.</p>
            <AuthorizeView Policy="@ChaosPolicies.Operate">
                <Authorized>
                    <div class="service-actions">
                        @* CpuSpike is hidden until Phase 5 decides whether it is implemented or removed:
                           no consumer applies it yet, so the button would report success for a no-op. *@
                        <button class="clear-button" disabled="@_isSubmitting" @onclick='() => CommitChaos("InventoryAPI", "None")'>Clear fault</button>
                    </div>
                </Authorized>
                <NotAuthorized><p class="view-only">View only</p></NotAuthorized>
            </AuthorizeView>
        </article>
    </section>

    @if (!string.IsNullOrWhiteSpace(_consoleLogMessage))
    {
        <div class="action-feedback" role="status">@_consoleLogMessage</div>
    }

    <section class="monitor-section">
        <div class="section-heading">
            <div><div class="eyebrow">LIVE TELEMETRY</div><h2>Service health</h2></div>
            <span class="poll-note">Updates every 3 seconds</span>
        </div>
        <ActiveFaultsTable @ref="_faultsTable" />
    </section>
</main>

@code {
    private string? _consoleLogMessage;
    private bool _isSubmitting;
    private bool _killSwitchEngaged; // inject buttons only; clearing stays allowed while engaged
    private ActiveFaultsTable? _faultsTable;

    // Engaging clears every fault server-side; show that now rather than on the next poll.
    private async Task OnKillSwitchChanged(bool engaged)
    {
        _killSwitchEngaged = engaged;
        if (engaged && _faultsTable is not null)
            await _faultsTable.RefreshAsync();
    }

    // The server derives the actor from the signed-in user, so no TriggeredBy is sent.
    private sealed record FaultInjectionRequest(string TargetService, string FaultType, int? LatencyMs = null);

    private async Task CommitChaos(string targetService, string faultType)
    {
        if (_isSubmitting)
            return;

        _isSubmitting = true;
        _consoleLogMessage = $"Sending {faultType} command to {targetService}…";
        var action = faultType == "None" ? $"clear {targetService}" : $"inject {faultType} on {targetService}";
        try
        {
            int? latencyMs = string.Equals(faultType, "Latency", StringComparison.OrdinalIgnoreCase) ? 3000 : null;
            var payload = new FaultInjectionRequest(targetService, faultType, latencyMs);
            using var response = await Api.PostAsJsonAsync("/api/v1/chaos/inject", payload);
            if (response.IsSuccessStatusCode)
            {
                var outcome = faultType == "None" ? "fault cleared" : $"{faultType} enabled";
                _consoleLogMessage = $"{targetService}: {outcome}.";
            }
            else
            {
                _consoleLogMessage = OperatorMessages.For(response.StatusCode, action);
            }
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Fault command to {Service} failed.", targetService);
            _consoleLogMessage = OperatorMessages.For(ex.StatusCode, action);
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
